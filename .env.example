# The variables the API reads, in the clear, for reference and for exporting by hand.
# Nothing loads this file. Local development on the host uses .env.development (the
# same variables, secrets encrypted with dotenvx) through `pnpm dev`; the compose stack
# sets its own inline. Production values come from Azure Key Vault via Container Apps
# secrets.
# The APPLICATION role, not the owner: the API refuses to start as a superuser or as
# the owner of the tables. `docker compose run --rm migrate` creates this role and sets
# this password. Migrations themselves run as postgres:postgres.
DATABASE_URL=postgres://athlete_app:athlete-app-local-password@localhost:5432/athlete
# The AUTH role: what better-auth connects as. It holds users, sessions and password
# hashes and nothing tenant-owned; the same migrate step creates it and sets this password.
AUTH_DATABASE_URL=postgres://athlete_auth:athlete-auth-local-password@localhost:5432/athlete
# The origin the browser sees: the Vite dev server, which proxies /api to the API. It is
# the only origin allowed to make state-changing requests.
APP_BASE_URL=http://localhost:5173
# Reverse proxies in front of the API, as comma-separated IPs or CIDR ranges, so the
# sign-in rate limit can tell clients apart. Empty locally: nothing is in front.
AUTH_TRUSTED_PROXIES=
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
# Signs session cookies (better-auth's `secret`).
SESSION_SECRET=dev-only-secret-change-me-at-least-32-chars
